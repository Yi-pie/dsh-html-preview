{
  "name": "dsh-html-preview",
  "version": "0.2.0",
  "description": "dsh插件｜DeepSeek Harness Web 插件：HTML 预览面板（网页预览 / HTML preview）——在右栏标签页中真实渲染页面、点击文字直接改文案、框选区域批注给 AI、整页缩放适配 PC 页面；点击会话中的 HTML 文件直接在右栏打开。已适配 DSH 0.2.x 的右栏标签页体系（sidebarRightTabs）。零构建、随 DSh 启动自动加载。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh插件",
    "deepseek-harness",
    "deepseek",
    "html-preview",
    "html预览",
    "web-preview",
    "网页预览",
    "annotate",
    "批注",
    "ai-annotate",
    "edit-copy",
    "改文案",
    "zoom",
    "fit-width",
    "缩放适配",
    "pc页面",
    "sidebar-right",
    "right-panel",
    "cordis",
    "web-ui",
    "preview-panel"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yi-pie/dsh-html-preview.git"
  },
  "homepage": "https://github.com/Yi-pie/dsh-html-preview#readme",
  "bugs": {
    "url": "https://github.com/Yi-pie/dsh-html-preview/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js"
  }
}
